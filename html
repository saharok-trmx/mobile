                    <div class="admin-btn-row" style="margin-top: 12px;">
                        <button class="admin-btn secondary" id="lockAdminBtn">🔒 Заблокировать</button>
                    </div>
                </div>
                <div class="admin-group">
                    <div class="admin-group-title">Конфигурация</div>
                    <div class="admin-btn-row">
                        <button class="admin-btn secondary" id="exportConfigBtn">📥 Экспорт</button>
                        <button class="admin-btn secondary" id="importConfigBtn">📤 Импорт</button>
                    </div>
                    <input type="file" id="importFileInput" accept="application/json" style="display:none;">
                </div>
                <div class="admin-group">
                    <div class="admin-group-title">Опасная зона</div>
                    <button class="admin-btn danger" id="clearAllBtn" style="width:100%;">Очистить все данные</button>
                </div>
                <div class="admin-group">
                    <div class="admin-group-title">Горячие клавиши</div>
                    <div style="font-size:13px; line-height:2; color: var(--ink-soft);">
                        <div>Ctrl + Shift + A — открыть админку</div>
                        <div>3× клик по логотипу — открыть админку</div>
                        <div>Esc — закрыть / выйти из редактирования</div>
                    </div>
                </div>
            </div>

            <div class="admin-section" data-admin-section="log">
                <div class="admin-group">
                    <div class="admin-group-title">События</div>
                    <div class="admin-log" id="adminLog"></div>
                </div>
            </div>
        </div>
    </aside>

    <script>
    (function() {
        'use strict';

        const STORAGE_KEY = 'lineev_config_v1';
        const STATS_KEY = 'lineev_stats_v1';
        const PIN_KEY = 'lineev_pin_v1';
        const PIN_ATTEMPTS_KEY = 'lineev_pin_attempts_v1';
        const PIN_LOCKOUT_KEY = 'lineev_pin_lockout_v1';
        const PIN_SESSION_KEY = 'lineev_admin_session';
        const MAX_ATTEMPTS = 3;
        const LOCKOUT_MS = 60 * 1000;
        const SESSION_MS = 5 * 60 * 1000;

        const isTouch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;

        const defaultConfig = {
            lang: 'ru',
            theme: 'dark',
            accent: '#ff5c35',
            statusVisible: true,
            statusTextRu: 'Открыт к 2 проектам',
            statusTextEn: 'Open for 2 projects',
            cursorEnabled: !isTouch,
            tiltEnabled: true,
            floatingEnabled: true,
            works: [
                { id: 'w1', titleRu: 'Проект 01', titleEn: 'Project 01', metaRu: 'Telegram-бот · В работе', metaEn: 'Telegram bot · In progress', image: '' },
                { id: 'w2', titleRu: 'Проект 02', titleEn: 'Project 02', metaRu: 'Сайт записи · В работе', metaEn: 'Booking site · In progress', image: '' }
            ],
            edits: {}
        };

        let config = { ...defaultConfig };
        let stats = { visits: 0, sessions: 0, tgClicks: 0, emailClicks: 0, formSubmits: 0, pricingViews: 0 };

        const $ = (s, ctx = document) => ctx.querySelector(s);
        const $$ = (s, ctx = document) => Array.from(ctx.querySelectorAll(s));

        function loadConfig() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (raw) config = { ...defaultConfig, ...JSON.parse(raw) };
            } catch(e) {}
        }

        function saveConfig() {
            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(config)); } catch(e) {}
        }

        function loadStats() {
            try {
                const raw = localStorage.getItem(STATS_KEY);
                if (raw) stats = JSON.parse(raw);
            } catch(e) {}
        }

        function saveStats() {
            try { localStorage.setItem(STATS_KEY, JSON.stringify(stats)); } catch(e) {}
        }

        function log(type, msg) {
            const logEl = $('#adminLog');
            if (!logEl) return;
            const time = new Date().toLocaleTimeString('ru-RU');
            const entry = document.createElement('div');
            entry.className = 'admin-log-entry';
            entry.innerHTML = `<span class="time">${time}</span><span class="type-${type}">${msg}</span>`;
            logEl.prepend(entry);
            while (logEl.children.length > 50) logEl.removeChild(logEl.lastChild);
        }

        function applyConfig() {
            document.documentElement.setAttribute('data-theme', config.theme);
            $('#themeSwitchAdmin')?.classList.toggle('on', config.theme === 'light');
            const themeBtn = $('#themeToggle');
            if (themeBtn) themeBtn.textContent = config.theme === 'light' ? '☾' : '☀';

            document.documentElement.style.setProperty('--accent', config.accent);
            $$('.color-swatch').forEach(s => s.classList.toggle('active', s.dataset.color === config.accent));

            document.documentElement.setAttribute('lang', config.lang);
            const langSwitch = $('#langSwitch');
            if (langSwitch) {
                langSwitch.classList.toggle('en', config.lang === 'en');
                $$('button[data-lang-btn]', langSwitch).forEach(b => b.classList.toggle('active', b.dataset.langBtn === config.lang));
            }
            const ta = $('.field textarea');
            if (ta) ta.placeholder = config.lang === 'ru' ? ta.dataset.placeholderRu : ta.dataset.placeholderEn;

            const hs = $('#heroStatus');
            if (hs) hs.classList.toggle('hidden', !config.statusVisible);
            const sr = $('[data-editable="hero-status-ru"]');
            const se = $('[data-editable="hero-status-en"]');
            if (sr && config.edits['hero-status-ru'] === undefined) sr.textContent = config.statusTextRu;
            if (se && config.edits['hero-status-en'] === undefined) se.textContent = config.statusTextEn;
            const stRu = $('#statusTextRu');
            const stEn = $('#statusTextEn');
            if (stRu) stRu.value = config.statusTextRu;
            if (stEn) stEn.value = config.statusTextEn;
            $('#statusToggle')?.classList.toggle('on', config.statusVisible);

            document.body.style.cursor = config.cursorEnabled ? 'none' : 'auto';
            const dot = $('.cursor-dot');
            const ring = $('.cursor-ring');
            if (dot) dot.style.display = config.cursorEnabled ? '' : 'none';
            if (ring) ring.style.display = config.cursorEnabled ? '' : 'none';
            $('#cursorToggle')?.classList.toggle('on', config.cursorEnabled);

            $('#tiltToggle')?.classList.toggle('on', config.tiltEnabled);
            const ftg = $('#floatingTg');
            if (ftg) ftg.style.display = config.floatingEnabled ? '' : 'none';
            $('#floatingToggle')?.classList.toggle('on', config.floatingEnabled);

            applyEdits();
            renderPortfolio();
        }

        function applyEdits() {
            $$('[data-editable]').forEach(el => {
                const key = el.dataset.editable;
                if (config.edits[key]) {
                    el.innerHTML = config.edits[key];
                }
            });
        }

        function renderPortfolio() {
            const grid = $('#portfolioGrid');
            if (!grid) return;
            grid.innerHTML = '';
            
            if (config.works.length === 0) {
                grid.innerHTML = '<div class="admin-empty" style="grid-column:1/-1">Пока нет работ. Добавьте в админке.</div>';
                return;
            }

            config.works.forEach((w, i) => {
                const a = document.createElement('a');
                a.href = '#';
                a.className = 'work reveal tilt visible';
                a.dataset.workId = w.id;
                
                const media = w.image 
                    ? `<img src="${w.image}" alt="${w.titleRu}" loading="lazy" onerror="this.style.display='none'">`
                    : `<div class="work-placeholder"><span class="icon">${i % 2 === 0 ? '◐' : '◑'}</span><span class="label" data-lang="ru">Скоро</span><span class="label" data-lang="en">Coming soon</span></div>`;
                
                a.innerHTML = `
                    ${media}
                    <div class="work-info">
                        <div>
                            <h4 data-lang="ru">${w.titleRu}</h4>
                            <h4 data-lang="en">${w.titleEn}</h4>
                            <span data-lang="ru">${w.metaRu}</span>
                            <span data-lang="en">${w.metaEn}</span>
                        </div>
                        <div class="work-arrow">↗</div>
                    </div>
                `;
                grid.appendChild(a);
            });

            if (config.tiltEnabled && !isTouch) {
                $$('.tilt').forEach(el => {
                    if (el.dataset.tiltBound) return;
                    el.dataset.tiltBound = '1';
                    el.addEventListener('mousemove', (e) => {
                        if (!config.tiltEnabled) return;
                        const rect = el.getBoundingClientRect();
                        const x = e.clientX - rect.left;
                        const y = e.clientY - rect.top;
                        const centerX = rect.width / 2;
                        const centerY = rect.height / 2;
                        const rotateX = ((y - centerY) / centerY) * -6;
                        const rotateY = ((x - centerX) / centerX) * 6;
                        el.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(0)`;
                    });
                    el.addEventListener('mouseleave', () => { el.style.transform = ''; });
                });
            }

            renderAdminWorksList();
        }

        function renderAdminWorksList() {
            const list = $('#adminWorksList');
            if (!list) return;
            if (config.works.length === 0) {
                list.innerHTML = '<div class="admin-empty">Нет работ</div>';
                return;
            }
            list.innerHTML = config.works.map(w => `
                <div class="admin-work-item">
                    <div class="admin-work-item-info">
                        <div class="admin-work-item-title">${w.titleRu}</div>
                        <div class="admin-work-item-meta">${w.metaRu}</div>
                    </div>
                    <button class="admin-work-remove" data-remove-work="${w.id}">×</button>
                </div>
            `).join('');
            
            $$('[data-remove-work]').forEach(btn => {
                btn.addEventListener('click', () => {
                    config.works = config.works.filter(w => w.id !== btn.dataset.removeWork);
                    saveConfig();
                    renderPortfolio();
                    log('info', 'Работа удалена');
                });
            });
        }

        /* ===== МОБИЛЬНОЕ МЕНЮ ===== */
        const burger = $('#burger');
        const mobileMenu = $('#mobileMenu');

        function openMobileMenu() {
            burger.classList.add('open');
            mobileMenu.classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeMobileMenu() {
            burger.classList.remove('open');
            mobileMenu.classList.remove('open');
            document.body.style.overflow = '';
        }

        burger.addEventListener('click', () => {
            if (mobileMenu.classList.contains('open')) {
                closeMobileMenu();
            } else {
                openMobileMenu();
            }
        });

        $$('[data-close-menu]').forEach(link => {
            link.addEventListener('click', () => {
                closeMobileMenu();
            });
        });

        /* ===== PIN ===== */
        const adminPanel = $('#adminPanel');
        const adminOverlay = $('#adminOverlay');
        const pinScreen = $('#pinScreen');
        const pinDots = $('#pinDots');
        const pinError = $('#pinError');
        const pinLockout = $('#pinLockout');
        const pinSubtitle = $('#pinSubtitle');
        const pinHint = $('#pinHint');

        let pinBuffer = '';
        let pinMode = 'enter';
        let pinSetupFirst = '';

        async function hashPin(pin) {
            const enc = new TextEncoder().encode(pin + '::lineev_salt');
            const buf = await crypto.subtle.digest('SHA-256', enc);
            return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
        }

        function hasPin() {
            return !!localStorage.getItem(PIN_KEY);
        }

        function getLockoutRemaining() {
            const lock = parseInt(localStorage.getItem(PIN_LOCKOUT_KEY) || '0');
            const remaining = lock - Date.now();
            return remaining > 0 ? remaining : 0;
        }

        function checkLockout() {
            const remaining = getLockoutRemaining();
            if (remaining > 0) {
                const sec = Math.ceil(remaining / 1000);
                pinLockout.textContent = `Подождите ${sec} сек.`;
                return true;
            }
            pinLockout.textContent = '';
            return false;
        }

        function registerFailedAttempt() {
            let attempts = parseInt(localStorage.getItem(PIN_ATTEMPTS_KEY) || '0');
            attempts++;
            localStorage.setItem(PIN_ATTEMPTS_KEY, attempts.toString());
            if (attempts >= MAX_ATTEMPTS) {
                localStorage.setItem(PIN_LOCKOUT_KEY, (Date.now() + LOCKOUT_MS).toString());
                localStorage.setItem(PIN_ATTEMPTS_KEY, '0');
                return true;
            }
            return false;
        }

        function resetAttempts() {
            localStorage.removeItem(PIN_ATTEMPTS_KEY);
            localStorage.removeItem(PIN_LOCKOUT_KEY);
        }

        function renderDots(length = 4) {
            pinDots.innerHTML = '';
            for (let i = 0; i < length; i++) {
                const dot = document.createElement('div');
                dot.className = 'pin-dot' + (i < pinBuffer.length ? ' filled' : '');
                pinDots.appendChild(dot);
            }
        }

        function showError(msg) {
            pinError.textContent = msg;
            pinError.classList.add('visible');
            pinDots.classList.add('shake');
            $$('.pin-dot').forEach(d => d.classList.add('error'));
            setTimeout(() => {
                pinDots.classList.remove('shake');
                pinError.classList.remove('visible');
                $$('.pin-dot').forEach(d => d.classList.remove('error'));
                pinBuffer = '';
                renderDots(4);
            }, 700);
        }

        function resetPinScreen() {
            pinBuffer = '';
            pinError.classList.remove('visible');
            pinDots.classList.remove('shake');
            renderDots(4);
        }

        function setupPinMode() {
            pinMode = 'setup';
            pinSetupFirst = '';
            pinSubtitle.textContent = 'Setup PIN';
            pinHint.innerHTML = 'Придумайте пинкод (4–8 цифр).<br>Он будет нужен для входа в админку.';
            resetPinScreen();
        }

        function enterPinMode() {
            pinMode = 'enter';
            pinSetupFirst = '';
            pinSubtitle.textContent = 'Admin access';
            pinHint.textContent = 'Введите пинкод для доступа';
            resetPinScreen();
        }

        function showPinScreen() {
            pinScreen.classList.add('open');
            checkLockout();
            if (!hasPin()) setupPinMode();
            else enterPinMode();
        }

        function hidePinScreen() {
            pinScreen.classList.remove('open');
            resetPinScreen();
        }

        function handleKey(key) {
            if (checkLockout()) return;
            
            if (key === 'del') {
                pinBuffer = pinBuffer.slice(0, -1);
                renderDots(4);
                return;
            }
            
            if (!/^\d$/.test(key)) return;
            if (pinBuffer.length >= 8) return;
            
            pinBuffer += key;
            renderDots(4);
            
            if (pinMode === 'enter' && pinBuffer.length === 4) {
                verifyPin();
            }
            if ((pinMode === 'setup' || pinMode === 'confirm') && pinBuffer.length === 4) {
                setTimeout(setupPin, 200);
            }
        }

        async function verifyPin() {
            const stored = localStorage.getItem(PIN_KEY);
            const hash = await hashPin(pinBuffer);
            
            if (hash === stored) {
                resetAttempts();
                localStorage.setItem(PIN_SESSION_KEY, Date.now().toString());
                hidePinScreen();
                openAdminPanel();
                log('info', 'Успешный вход в админку');
            } else {
                const locked = registerFailedAttempt();
                if (locked) {
                    showError('Слишком много попыток');
                    pinBuffer = '';
                    checkLockout();
                } else {
                    const attempts = parseInt(localStorage.getItem(PIN_ATTEMPTS_KEY) || '0');
                    const left = MAX_ATTEMPTS - attempts;
                    showError(`Неверный пинкод. Осталось: ${left}`);
                }
            }
        }

        async function setupPin() {
            if (pinMode === 'setup') {
                if (pinBuffer.length < 4) {
                    showError('Минимум 4 цифры');
                    return;
                }
                pinSetupFirst = pinBuffer;
                pinBuffer = '';
                renderDots(4);
                pinMode = 'confirm';
                pinSubtitle.textContent = 'Confirm PIN';
                pinHint.textContent = 'Повторите пинкод';
            } else if (pinMode === 'confirm') {
                if (pinBuffer !== pinSetupFirst) {
                    showError('Пинкоды не совпадают');
                    pinMode = 'setup';
                    pinSetupFirst = '';
                    pinSubtitle.textContent = 'Setup PIN';
                    pinHint.textContent = 'Придумайте пинкод (4–8 цифр)';
                    pinBuffer = '';
                    return;
                }
                const hash = await hashPin(pinBuffer);
                localStorage.setItem(PIN_KEY, hash);
                localStorage.setItem(PIN_SESSION_KEY, Date.now().toString());
                log('info', 'Пинкод установлен');
                hidePinScreen();
                openAdminPanel();
            }
        }

        function openAdminPanel() {
            adminPanel.classList.add('open');
            adminOverlay.classList.add('open');
            renderAdminWorksList();
            updateStatsUI();
            document.body.style.overflow = 'hidden';
            log('info', 'Админка открыта');
        }

        function closeAdmin() {
            adminPanel.classList.remove('open');
            adminOverlay.classList.remove('open');
            if (!mobileMenu.classList.contains('open')) {
                document.body.style.overflow = '';
            }
        }

        function requestAdminAccess() {
            if (adminPanel.classList.contains('open')) return;
            
            const session = localStorage.getItem(PIN_SESSION_KEY);
            if (session) {
                const elapsed = Date.now() - parseInt(session);
                if (elapsed < SESSION_MS) {
                    openAdminPanel();
                    return;
                }
            }
            
            showPinScreen();
        }

        $('#adminClose').addEventListener('click', closeAdmin);
        adminOverlay.addEventListener('click', closeAdmin);
        
        $$('.pin-key[data-key]').forEach(btn => {
            btn.addEventListener('click', () => handleKey(btn.dataset.key));
        });

        document.addEventListener('keydown', (e) => {
            if (!pinScreen.classList.contains('open')) return;
            if (e.key === 'Escape') { hidePinScreen(); return; }
            if (e.key === 'Backspace') {
                e.preventDefault();
                handleKey('del');
                return;
            }
            if (e.key === 'Enter') {
                e.preventDefault();
                if (pinMode === 'enter' && pinBuffer.length >= 4) verifyPin();
                else if ((pinMode === 'setup' || pinMode === 'confirm') && pinBuffer.length >= 4) setupPin();
                return;
            }
            if (/^\d$/.test(e.key)) handleKey(e.key);
        });

        document.addEventListener('keydown', (e) => {
            if (e.ctrlKey && e.shiftKey && (e.key === 'A' || e.key === 'a')) {
                e.preventDefault();
                requestAdminAccess();
            }
            if (e.key === 'Escape') {
                if (document.body.classList.contains('editing')) {
                    exitEditMode();
                } else if (adminPanel.classList.contains('open')) {
                    closeAdmin();
                } else if (mobileMenu.classList.contains('open')) {
                    closeMobileMenu();
                }
            }
        });

        const logo = $('#logo');
        let clickCount = 0;
        let clickTimer = null;
        logo.addEventListener('click', () => {
            clickCount++;
            if (clickCount === 1) {
                clickTimer = setTimeout(() => { clickCount = 0; }, 800);
            }
            if (clickCount === 3) {
                clearTimeout(clickTimer);
                clickCount = 0;
                requestAdminAccess();
            }
        });

        $$('.admin-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                $$('.admin-tab').forEach(t => t.classList.remove('active'));
                $$('.admin-section').forEach(s => s.classList.remove('active'));
                tab.classList.add('active');
                $(`[data-admin-section="${tab.dataset.adminTab}"]`).classList.add('active');
            });
        });

        const editIndicator = $('#editIndicator');

        function enterEditMode() {
            document.body.classList.add('editing');
            editIndicator.classList.add('visible');
            $$('[data-editable]').forEach(el => {
                el.setAttribute('contenteditable', 'true');
                el.addEventListener('blur', handleEditBlur);
                el.addEventListener('keydown', handleEditKey);
            });
            closeAdmin();
            log('info', 'Режим редактирования включён');
        }

        function exitEditMode() {
            document.body.classList.remove('editing');
            editIndicator.classList.remove('visible');
            $$('[data-editable]').forEach(el => {
                el.removeAttribute('contenteditable');
                el.removeEventListener('blur', handleEditBlur);
                el.removeEventListener('keydown', handleEditKey);
            });
            log('info', 'Режим редактирования выключен');
        }

        function handleEditBlur(e) {
            config.edits[e.target.dataset.editable] = e.target.innerHTML;
            saveConfig();
        }

        function handleEditKey(e) {
            if (e.key === 'Escape') {
                e.preventDefault();
                e.target.blur();
                exitEditMode();
            }
        }

        $('#startEditBtn').addEventListener('click', enterEditMode);

        $('#resetContentBtn').addEventListener('click', () => {
            if (confirm('Сбросить все изменения контента?')) {
                config.edits = {};
                saveConfig();
                location.reload();
            }
        });

        $('#themeToggle').addEventListener('click', () => {
            config.theme = config.theme === 'dark' ? 'light' : 'dark';
            saveConfig();
            applyConfig();
            log('info', 'Тема: ' + config.theme);
        });

        $('#themeSwitchAdmin').addEventListener('click', () => {
            config.theme = config.theme === 'dark' ? 'light' : 'dark';
            saveConfig();
            applyConfig();
        });

        $$('#langSwitch button[data-lang-btn]').forEach(btn => {
            btn.addEventListener('click', () => {
                config.lang = btn.dataset.langBtn;
                saveConfig();
                applyConfig();
            });
        });

        $$('.color-swatch').forEach(swatch => {
            swatch.addEventListener('click', () => {
                config.accent = swatch.dataset.color;
                saveConfig();
                applyConfig();
                log('info', 'Accent: ' + config.accent);
            });
        });

        $('#statusToggle').addEventListener('click', () => {
            config.statusVisible = !config.statusVisible;
            saveConfig();
            applyConfig();
        });

        $('#statusTextRu').addEventListener('input', (e) => {
            config.statusTextRu = e.target.value;
            saveConfig();
            const el = $('[data-editable="hero-status-ru"]');
            if (el && !config.edits['hero-status-ru']) el.textContent = e.target.value;
        });
        $('#statusTextEn').addEventListener('input', (e) => {
            config.statusTextEn = e.target.value;
            saveConfig();
            const el = $('[data-editable="hero-status-en"]');
            if (el && !config.edits['hero-status-en']) el.textContent = e.target.value;
        });

        $('#cursorToggle').addEventListener('click', () => {
            config.cursorEnabled = !config.cursorEnabled;
            saveConfig();
            applyConfig();
        });
        $('#tiltToggle').addEventListener('click', () => {
            config.tiltEnabled = !config.tiltEnabled;
            saveConfig();
            applyConfig();
        });
        $('#floatingToggle').addEventListener('click', () => {
            config.floatingEnabled = !config.floatingEnabled;
            saveConfig();
            applyConfig();
        });

        $('#addWorkBtn').addEventListener('click', () => {
            const tRu = $('#workTitleRu').value.trim();
            const tEn = $('#workTitleEn').value.trim() || tRu;
            const mRu = $('#workMetaRu').value.trim();
            const mEn = $('#workMetaEn').value.trim() || mRu;
            const img = $('#workImage').value.trim();
            
            if (!tRu) { alert('Введите название (RU)'); return; }
            
            config.works.push({
                id: 'w' + Date.now(),
                titleRu: tRu, titleEn: tEn,
                metaRu: mRu, metaEn: mEn,
                image: img
            });
            saveConfig();
            renderPortfolio();
            
            $('#workTitleRu').value = '';
            $('#workTitleEn').value = '';
            $('#workMetaRu').value = '';
            $('#workMetaEn').value = '';
            $('#workImage').value = '';
            
            log('info', 'Работа добавлена: ' + tRu);
        });

        function updateStatsUI() {
            $('#statVisits').textContent = stats.visits;
            $('#statSessions').textContent = stats.sessions;
            $('#statTgClicks').textContent = stats.tgClicks;
            $('#statEmailClicks').textContent = stats.emailClicks;
            $('#statFormSubmits').textContent = stats.formSubmits;
            $('#statPricingViews').textContent = stats.pricingViews;
        }

        $('#resetStatsBtn').addEventListener('click', () => {
            if (confirm('Сбросить статистику?')) {
                stats = { visits: 0, sessions: 0, tgClicks: 0, emailClicks: 0, formSubmits: 0, pricingViews: 0 };
                saveStats();
                updateStatsUI();
                log('warn', 'Статистика сброшена');
            }
        });

        document.addEventListener('click', (e) => {
            const a = e.target.closest('a');
            if (!a) return;
            const href = a.getAttribute('href') || '';
            if (href.includes('t.me/')) {
                stats.tgClicks++;
                saveStats();
            } else if (href.startsWith('mailto:')) {
                stats.emailClicks++;
                saveStats();
            }
        });

        $('#exportConfigBtn').addEventListener('click', () => {
            const data = JSON.stringify({ config, stats }, null, 2);
            const blob = new Blob([data], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'lineev-config-' + new Date().toISOString().slice(0, 10) + '.json';
            a.click();
            URL.revokeObjectURL(url);
            log('info', 'Конфиг экспортирован');
        });

        $('#importConfigBtn').addEventListener('click', () => $('#importFileInput').click());

        $('#importFileInput').addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (ev) => {
                try {
                    const data = JSON.parse(ev.target.result);
                    if (data.config) config = { ...defaultConfig, ...data.config };
                    if (data.stats) stats = data.stats;
                    saveConfig();
                    saveStats();
                    applyConfig();
                    updateStatsUI();
                    log('info', 'Конфиг импортирован');
                    alert('Импорт успешен');
                } catch(err) {
                    alert('Ошибка импорта: ' + err.message);
                }
            };
            reader.readAsText(file);
            e.target.value = '';
        });

        $('#clearAllBtn').addEventListener('click', () => {
            if (confirm('Удалить ВСЕ данные? Страница перезагрузится.')) {
                localStorage.removeItem(STORAGE_KEY);
                localStorage.removeItem(STATS_KEY);
                localStorage.removeItem(PIN_KEY);
                localStorage.removeItem(PIN_ATTEMPTS_KEY);
                localStorage.removeItem(PIN_LOCKOUT_KEY);
                localStorage.removeItem(PIN_SESSION_KEY);
                location.reload();
            }
        });

        $('#lockAdminBtn').addEventListener('click', () => {
            localStorage.removeItem(PIN_SESSION_KEY);
            closeAdmin();
            log('info', 'Сессия админки завершена');
        });

        $('#changePinBtn').addEventListener('click', async () => {
            const currentInput = $('#pinCurrent');
            const newInput = $('#pinNew');
            const confirmInput = $('#pinConfirm');
            const status = $('#pinChangeStatus');
            
            status.textContent = '';
            status.style.color = '';
            
            const current = currentInput.value.trim();
            const newPin = newInput.value.trim();
            const confirm = confirmInput.value.trim();
            
            if (!/^\d{4,8}$/.test(newPin)) {
                status.textContent = 'Новый пинкод: 4–8 цифр';
                status.style.color = '#ff5555';
                return;
            }
            if (newPin !== confirm) {
                status.textContent = 'Новые пинкоды не совпадают';
                status.style.color = '#ff5555';
                return;
            }
            
            const stored = localStorage.getItem(PIN_KEY);
            const hashCurrent = await hashPin(current);
            if (hashCurrent !== stored) {
                status.textContent = 'Неверный текущий пинкод';
                status.style.color = '#ff5555';
                return;
            }
            
            const hashNew = await hashPin(newPin);
            localStorage.setItem(PIN_KEY, hashNew);
            resetAttempts();
            
            currentInput.value = '';
            newInput.value = '';
            confirmInput.value = '';
            
            status.textContent = '✓ Пинкод обновлён';
            status.style.color = '#4ade80';
            log('info', 'Пинкод изменён');
            
            setTimeout(() => { status.textContent = ''; }, 3000);
        });

        setInterval(() => {
            if (pinScreen.classList.contains('open')) checkLockout();
        }, 1000);

        /* ===== КУРСОР ===== */
        const dot = $('.cursor-dot');
        const ring = $('.cursor-ring');
        let mouse = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
        let ringPos = { x: mouse.x, y: mouse.y };
        let magnetTarget = null;

        function lerp(a, b, t) { return a + (b - a) * t; }

        document.addEventListener('mousemove', (e) => {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
            if (config.cursorEnabled && !isTouch) {
                dot.style.transform = `translate(${mouse.x}px, ${mouse.y}px)`;
            }
        });

        function animateRing() {
            if (config.cursorEnabled && !isTouch) {
                let targetX = mouse.x;
                let targetY = mouse.y;
                if (magnetTarget) {
                    const rect = magnetTarget.getBoundingClientRect();
                    targetX = rect.left + rect.width / 2;
                    targetY = rect.top + rect.height / 2;
                }
                ringPos.x = lerp(ringPos.x, targetX, 0.15);
                ringPos.y = lerp(ringPos.y, targetY, 0.15);
                ring.style.transform = `translate(${ringPos.x}px, ${ringPos.y}px)`;
            }
            requestAnimationFrame(animateRing);
        }
        animateRing();

        function bindCursor() {
            if (isTouch) return;
            const hoverables = $$('a, button, input, textarea, .skill-row, .work, .social-link, .channel, .faq-item, .price-card');
            const magnetables = $$('.btn, .social-link, .work-arrow, .nav-links a, .channel-arrow, .floating-tg');
            
            hoverables.forEach(el => {
                if (el.dataset.cursorBound) return;
                el.dataset.cursorBound = '1';
                el.addEventListener('mouseenter', () => {
                    if (!config.cursorEnabled) return;
                    ring.classList.add('is-hover');
                    dot.classList.add('is-hover');
                });
                el.addEventListener('mouseleave', () => {
                    ring.classList.remove('is-hover');
                    dot.classList.remove('is-hover');
                    magnetTarget = null;
                    ring.classList.remove('is-magnetic');
                    dot.classList.remove('is-magnetic');
                });
            });
            
            magnetables.forEach(el => {
                if (el.dataset.magnetBound) return;
                el.dataset.magnetBound = '1';
                el.addEventListener('mouseenter', () => {
                    if (!config.cursorEnabled) return;
                    magnetTarget = el;
                    ring.classList.add('is-magnetic');
                    dot.classList.add('is-magnetic');
                });
            });
        }
        bindCursor();

        document.addEventListener('mousedown', () => { if (config.cursorEnabled && !isTouch) ring.classList.add('is-click'); });
        document.addEventListener('mouseup', () => ring.classList.remove('is-click'));
        document.addEventListener('mouseleave', () => { dot.style.opacity = '0'; ring.style.opacity = '0'; });
        document.addEventListener('mouseenter', () => { dot.style.opacity = '1'; ring.style.opacity = '0.55'; });

        /* ===== НАВБАР + ПРОГРЕСС + FLOATING ===== */
        const navbar = $('#navbar');
        const progress = $('#scrollProgress');
        const floatingTg = $('#floatingTg');
        const navLinks = $$('.nav-links a[data-section]');

        let lastScrollY = 0;
        let floatingVisible = false;

        function updateScroll() {
            const scrollY = window.scrollY;
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            const pct = docHeight > 0 ? (scrollY / docHeight) * 100 : 0;
            
            navbar.classList.toggle('scrolled', scrollY > 50);
            progress.style.width = pct + '%';
            
            // Умная плавающая кнопка
            if (config.floatingEnabled) {
                const shouldShow = scrollY > window.innerHeight * 0.4;
                if (shouldShow && !floatingVisible) {
                    floatingTg.classList.add('visible');
                    floatingVisible = true;
                } else if (!shouldShow && floatingVisible) {
                    floatingTg.classList.remove('visible');
                    floatingVisible = false;
                }
                
                // Скрываем при скролле вниз, показываем при скролле вверх
                if (shouldShow) {
                    if (scrollY > lastScrollY + 10) {
                        floatingTg.classList.add('hidden-scroll');
                    } else if (scrollY < lastScrollY - 10) {
                        floatingTg.classList.remove('hidden-scroll');
                    }
                }
            }
            
            lastScrollY = scrollY;
            
            const sections = ['about', 'skills', 'process', 'pricing', 'work', 'faq', 'contact'];
            let current = '';
            sections.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    const rect = el.getBoundingClientRect();
                    if (rect.top <= window.innerHeight * 0.4) current = id;
                }
            });
            navLinks.forEach(link => {
                link.classList.toggle('active', link.dataset.section === current);
            });
        }
        window.addEventListener('scroll', updateScroll, { passive: true });
        updateScroll();

        /* ===== REVEAL ===== */
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry, i) => {
                if (entry.isIntersecting) {
                    setTimeout(() => entry.target.classList.add('visible'), i * 80);
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
        $$('.reveal').forEach(el => observer.observe(el));

        /* ===== СЧЁТЧИКИ ===== */
        const counterObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const counter = entry.target;
                    const target = parseInt(counter.dataset.target);
                    const duration = 1200;
                    const start = performance.now();
                    function animateCounter(now) {
                        const elapsed = now - start;
                        const progress = Math.min(elapsed / duration, 1);
                        const eased = 1 - Math.pow(1 - progress, 3);
                        counter.textContent = Math.round(target * eased);
                        if (progress < 1) requestAnimationFrame(animateCounter);
                    }
                    requestAnimationFrame(animateCounter);
                    counterObserver.unobserve(counter);
                }
            });
        }, { threshold: 0.5 });
        $$('.counter').forEach(c => counterObserver.observe(c));

        /* ===== FAQ ===== */
        $$('.faq-item').forEach(item => {
            item.querySelector('.faq-question').addEventListener('click', () => {
                const isOpen = item.classList.contains('open');
                $$('.faq-item.open').forEach(other => {
                    if (other !== item) other.classList.remove('open');
                });
                item.classList.toggle('open', !isOpen);
            });
        });

        /* ===== ТРЕКИНГ ЦЕН ===== */
        const pricingSection = document.getElementById('pricing');
        if (pricingSection) {
            const priceObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        stats.pricingViews++;
                        saveStats();
                        priceObserver.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.3 });
            priceObserver.observe(pricingSection);
        }

        /* ===== ФОРМА ===== */
        const BOT_TOKEN = 'YOUR_BOT_TOKEN';
        const CHAT_ID = 'YOUR_CHAT_ID';

        $('#contactForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            const btn = form.querySelector('button');
            const status = $('#formStatus');
            const lang = config.lang;
            
            const name = form.querySelector('input[name="name"]').value.trim();
            const email = form.querySelector('input[name="email"]').value.trim();
            const message = form.querySelector('textarea[name="message"]').value.trim();
            
            const original = btn.innerHTML;
            btn.innerHTML = lang === 'ru' ? '<span>Отправка...</span>' : '<span>Sending...</span>';
            btn.disabled = true;
            status.textContent = '';
            status.className = 'form-status';
            
            const text = `🔔 Новая заявка\n\n👤 ${name}\n📧 ${email}\n💬 ${message}`;
            
            try {
                if (BOT_TOKEN === 'YOUR_BOT_TOKEN' || CHAT_ID === 'YOUR_CHAT_ID') {
                    await new Promise(r => setTimeout(r, 800));
                    log('warn', 'DEMO режим: ' + text);
                } else {
                    const response = await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ chat_id: CHAT_ID, text, parse_mode: 'HTML' })
                    });
                    if (!response.ok) throw new Error('Telegram API');
                }
                
                stats.formSubmits++;
                saveStats();
                
                status.textContent = lang === 'ru' ? '✓ Заявка отправлена!' : '✓ Message sent!';
                status.className = 'form-status success';
                btn.innerHTML = lang === 'ru' ? '<span>Отправлено ✓</span>' : '<span>Sent ✓</span>';
                btn.style.background = '#4ade80';
                btn.style.borderColor = '#4ade80';
                form.reset();
                log('info', 'Заявка отправлена: ' + email);
                
                setTimeout(() => {
                    btn.innerHTML = original;
                    btn.style.background = '';
                    btn.style.borderColor = '';
                    btn.disabled = false;
                }, 3000);
            } catch (err) {
                status.textContent = lang === 'ru' ? '✗ Ошибка. Напишите в Telegram' : '✗ Error. Write to Telegram';
                status.className = 'form-status error';
                btn.innerHTML = original;
                btn.disabled = false;
                log('error', 'Ошибка формы: ' + err.message);
            }
        });

        /* ===== SMOOTH SCROLL ===== */
        $$('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const href = this.getAttribute('href');
                if (href === '#') return;
                const target = document.querySelector(href);
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        /* ===== ИНИЦИАЛИЗАЦИЯ ===== */
        loadConfig();
        loadStats();
        applyConfig();
        updateStatsUI();

        if (!sessionStorage.getItem('session_counted')) {
            stats.sessions++;
            stats.visits++;
            saveStats();
            sessionStorage.setItem('session_counted', '1');
            updateStatsUI();
        }

        log('info', 'Сайт загружен');
        log('info', 'Ctrl+Shift+A или 3× клик по логотипу — админка');

        if (!localStorage.getItem(STORAGE_KEY)) {
            if (window.matchMedia('(prefers-color-scheme: light)').matches) {
                config.theme = 'light';
                saveConfig();
                applyConfig();
            }
        }

    })();
    </script>
</body>
</html>
