<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#1a1a1d">
    
    <title>Lineev — Telegram-боты, сайты и AI-автоматизация</title>
    <meta name="description" content="Разработка Telegram-ботов для записи клиентов, сайтов и интеграция AI-агентов. Автоматизация бизнес-процессов.">
    <meta name="author" content="Lineev">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Lineev — Telegram-боты, сайты и AI-автоматизация">
    <meta property="og:description" content="Помогаю бизнесу автоматизировать запись клиентов и рутину.">
    
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%231a1a1d'/><text x='50' y='68' font-size='60' font-family='Arial' font-weight='bold' text-anchor='middle' fill='%23ff5c35'>L</text></svg>">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg: #1a1a1d;
            --bg-alt: #232326;
            --bg-elev: #2a2a2e;
            --ink: #ececee;
            --ink-soft: #a8a8b0;
            --ink-mute: #6e6e78;
            --accent: #ff5c35;
            --line: rgba(236, 236, 238, 0.09);
            --line-strong: rgba(236, 236, 238, 0.16);
            --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --safe-top: env(safe-area-inset-top, 0px);
            --safe-bottom: env(safe-area-inset-bottom, 0px);
            --safe-left: env(safe-area-inset-left, 0px);
            --safe-right: env(safe-area-inset-right, 0px);
        }

        html[data-theme="light"] {
            --bg: #f5f4f0;
            --bg-alt: #ebe9e3;
            --bg-elev: #e3e1da;
            --ink: #14141a;
            --ink-soft: #55555f;
            --ink-mute: #8d8d96;
            --line: rgba(20, 20, 26, 0.1);
            --line-strong: rgba(20, 20, 26, 0.2);
        }

        html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

        body {
            font-family: var(--font);
            background: var(--bg);
            color: var(--ink);
            overflow-x: hidden;
            cursor: none;
            line-height: 1.5;
            transition: background 0.4s, color 0.4s;
            -webkit-tap-highlight-color: transparent;
            min-height: 100dvh;
        }

        img { max-width: 100%; height: auto; display: block; }
        button { font-family: inherit; }

        /* ===== КУРСОР ===== */
        .cursor-dot, .cursor-ring {
            position: fixed; top: 0; left: 0;
            pointer-events: none; z-index: 99999;
            border-radius: 50%; will-change: transform;
        }
        .cursor-dot {
            width: 6px; height: 6px; background: var(--ink);
            margin: -3px 0 0 -3px;
            transition: transform 0.15s ease, background 0.2s;
        }
        .cursor-ring {
            width: 36px; height: 36px; border: 1.5px solid var(--ink);
            margin: -18px 0 0 -18px;
            transition: width 0.35s cubic-bezier(0.16,1,0.3,1), height 0.35s cubic-bezier(0.16,1,0.3,1),
                        margin 0.35s cubic-bezier(0.16,1,0.3,1), border-color 0.3s, opacity 0.3s, background 0.3s;
            opacity: 0.55;
        }
        .cursor-ring.is-hover {
            width: 60px; height: 60px; margin: -30px 0 0 -30px;
            border-color: var(--accent); background: rgba(255,92,53,0.1); opacity: 1;
        }
        .cursor-dot.is-hover { background: var(--accent); transform: scale(0); }
        .cursor-ring.is-magnetic {
            width: 70px; height: 70px; margin: -35px 0 0 -35px;
            border-color: var(--accent); opacity: 1;
        }
        .cursor-dot.is-magnetic { transform: scale(0); }
        .cursor-ring.is-click {
            width: 24px; height: 24px; margin: -12px 0 0 -12px;
            background: var(--accent); border-color: var(--accent);
        }

        /* ===== ПРОГРЕСС ===== */
        .scroll-progress {
            position: fixed; top: 0; left: 0; height: 2px; width: 0%;
            background: var(--accent); z-index: 9998; transition: width 0.1s;
        }

        /* ===== НАВИГАЦИЯ ===== */
        nav {
            position: fixed; top: 0; left: 0; width: 100%;
            padding: calc(var(--safe-top) + 24px) calc(var(--safe-right) + 56px) 24px calc(var(--safe-left) + 56px);
            display: flex; justify-content: space-between; align-items: center;
            z-index: 1000; transition: all 0.5s cubic-bezier(0.16,1,0.3,1);
        }
        nav.scrolled {
            padding: calc(var(--safe-top) + 14px) calc(var(--safe-right) + 56px) 14px calc(var(--safe-left) + 56px);
            background: rgba(26, 26, 29, 0.82);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--line);
        }
        html[data-theme="light"] nav.scrolled { background: rgba(245, 244, 240, 0.82); }

        .logo {
            font-size: 15px; font-weight: 600; letter-spacing: -0.02em;
            cursor: none; user-select: none; -webkit-user-select: none;
            padding: 10px 0; z-index: 1100; position: relative;
        }
        .logo span { color: var(--accent); }

        .nav-right { display: flex; align-items: center; gap: 24px; }

        .nav-links { display: flex; gap: 28px; list-style: none; }
        .nav-links a {
            color: var(--ink-soft); text-decoration: none; font-size: 13px; font-weight: 500;
            position: relative; padding: 8px 0; transition: color 0.3s; cursor: none;
        }
        .nav-links a::after {
            content: ''; position: absolute; bottom: 4px; left: 0; width: 0; height: 1.5px;
            background: var(--accent); transition: width 0.4s cubic-bezier(0.16,1,0.3,1);
        }
        .nav-links a:hover, .nav-links a.active { color: var(--ink); }
        .nav-links a:hover::after, .nav-links a.active::after { width: 100%; }

        .nav-tools { display: flex; align-items: center; gap: 8px; }

        .lang-switch {
            display: flex; gap: 4px; padding: 3px;
            border: 1px solid var(--line-strong); border-radius: 100px; position: relative;
        }
        .lang-switch button {
            background: none; border: none; color: var(--ink-mute);
            font-size: 11px; font-weight: 600; letter-spacing: 0.05em;
            padding: 6px 12px; border-radius: 100px; cursor: none;
            transition: color 0.3s; z-index: 1; min-height: 28px;
        }
        .lang-switch button.active { color: var(--bg); }
        .lang-switch .slider {
            position: absolute; top: 3px; bottom: 3px; left: 3px;
            width: calc(50% - 3px); background: var(--ink); border-radius: 100px;
            transition: transform 0.4s cubic-bezier(0.16,1,0.3,1);
        }
        .lang-switch.en .slider { transform: translateX(100%); }

        .theme-toggle {
            width: 36px; height: 36px; border: 1px solid var(--line-strong);
            border-radius: 50%; background: transparent; color: var(--ink);
            display: flex; align-items: center; justify-content: center;
            cursor: none; transition: all 0.3s; font-size: 14px;
        }
        .theme-toggle:hover { border-color: var(--accent); color: var(--accent); transform: rotate(20deg); }

        /* Бургер */
        .burger {
            display: none; width: 44px; height: 44px; border: 1px solid var(--line-strong);
            border-radius: 50%; background: transparent; color: var(--ink);
            cursor: pointer; align-items: center; justify-content: center;
            position: relative; z-index: 1100; flex-shrink: 0;
        }
        .burger-lines {
            width: 18px; height: 12px; position: relative;
            display: flex; flex-direction: column; justify-content: space-between;
        }
        .burger-lines span {
            display: block; height: 1.5px; background: currentColor;
            border-radius: 2px; transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
            transform-origin: center;
        }
        .burger.open .burger-lines span:nth-child(1) {
            transform: translateY(5.25px) rotate(45deg);
        }
        .burger.open .burger-lines span:nth-child(2) {
            opacity: 0; transform: scaleX(0);
        }
        .burger.open .burger-lines span:nth-child(3) {
            transform: translateY(-5.25px) rotate(-45deg);
        }

        /* Мобильное меню */
        .mobile-menu {
            position: fixed; inset: 0; z-index: 1050;
            background: var(--bg); opacity: 0; pointer-events: none;
            transition: opacity 0.4s cubic-bezier(0.16,1,0.3,1);
            display: flex; flex-direction: column;
            padding: calc(var(--safe-top) + 80px) 24px calc(var(--safe-bottom) + 32px);
            overflow-y: auto;
        }
        .mobile-menu.open { opacity: 1; pointer-events: auto; }
        .mobile-menu-list {
            list-style: none; display: flex; flex-direction: column; gap: 4px;
            flex: 1; margin-bottom: 32px;
        }
        .mobile-menu-list li {
            opacity: 0; transform: translateY(20px);
            transition: opacity 0.4s, transform 0.4s;
        }
        .mobile-menu.open .mobile-menu-list li {
            opacity: 1; transform: translateY(0);
        }
        .mobile-menu.open .mobile-menu-list li:nth-child(1) { transition-delay: 0.1s; }
        .mobile-menu.open .mobile-menu-list li:nth-child(2) { transition-delay: 0.15s; }
        .mobile-menu.open .mobile-menu-list li:nth-child(3) { transition-delay: 0.2s; }
        .mobile-menu.open .mobile-menu-list li:nth-child(4) { transition-delay: 0.25s; }
        .mobile-menu.open .mobile-menu-list li:nth-child(5) { transition-delay: 0.3s; }
        .mobile-menu.open .mobile-menu-list li:nth-child(6) { transition-delay: 0.35s; }
        .mobile-menu.open .mobile-menu-list li:nth-child(7) { transition-delay: 0.4s; }

        .mobile-menu-list a {
            display: flex; justify-content: space-between; align-items: center;
            padding: 18px 0; border-bottom: 1px solid var(--line);
            color: var(--ink); text-decoration: none;
            font-size: 24px; font-weight: 600; letter-spacing: -0.02em;
            transition: color 0.3s;
        }
        .mobile-menu-list a:active { color: var(--accent); }
        .mobile-menu-list a .num {
            font-size: 12px; color: var(--ink-mute); font-weight: 400;
            letter-spacing: 0.1em;
        }

        .mobile-menu-bottom {
            display: flex; align-items: center; justify-content: space-between;
            gap: 16px; padding-top: 24px;
            border-top: 1px solid var(--line);
            opacity: 0; transition: opacity 0.4s 0.45s;
        }
        .mobile-menu.open .mobile-menu-bottom { opacity: 1; }

        /* ===== HERO ===== */
        .hero {
            min-height: 100dvh; display: flex; flex-direction: column; justify-content: center;
            padding: calc(var(--safe-top) + 100px) calc(var(--safe-right) + 56px) calc(var(--safe-bottom) + 60px) calc(var(--safe-left) + 56px);
            position: relative;
        }
        .hero-status {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 8px 14px; background: rgba(255,92,53,0.1);
            border: 1px solid rgba(255,92,53,0.3); border-radius: 100px;
            font-size: 12px; color: var(--accent); margin-bottom: 24px;
            width: fit-content;
            opacity: 0; animation: rise 0.9s cubic-bezier(0.16,1,0.3,1) 0.3s forwards;
        }
        .hero-status .pulse {
            width: 6px; height: 6px; background: var(--accent); border-radius: 50%;
            animation: pulse 2s infinite;
        }
        .hero-status.hidden { display: none; }

        .hero-meta {
            display: flex; align-items: center; gap: 12px;
            font-size: 13px; color: var(--ink-mute); letter-spacing: 0.05em;
            text-transform: uppercase; margin-bottom: 32px;
            opacity: 0; animation: rise 0.9s cubic-bezier(0.16,1,0.3,1) 0.2s forwards;
        }
        .hero-meta::before { content: ''; width: 32px; height: 1px; background: var(--accent); }

        .hero-title {
            font-size: clamp(40px, 9vw, 132px); font-weight: 600;
            line-height: 0.95; letter-spacing: -0.04em; margin-bottom: 40px;
        }
        .hero-title .line { display: block; overflow: hidden; }
        .hero-title .line span {
            display: inline-block; transform: translateY(110%);
            animation: revealLine 1.1s cubic-bezier(0.16,1,0.3,1) forwards;
        }
        .hero-title .line:nth-child(1) span { animation-delay: 0.3s; }
        .hero-title .line:nth-child(2) span { animation-delay: 0.42s; }
        .hero-title .line:nth-child(3) span { animation-delay: 0.54s; }
        .hero-title em { font-style: normal; color: var(--accent); }

        .hero-bottom {
            display: flex; justify-content: space-between; align-items: flex-end; gap: 40px;
            opacity: 0; animation: rise 0.9s cubic-bezier(0.16,1,0.3,1) 0.9s forwards;
        }
        .hero-desc {
            font-size: 16px; color: var(--ink-soft);
            max-width: 480px; line-height: 1.7;
        }
        .hero-actions { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }

        .hero-scroll {
            font-size: 12px; color: var(--ink-mute); letter-spacing: 0.1em;
            text-transform: uppercase; display: flex; align-items: center; gap: 10px;
            white-space: nowrap;
        }
        .hero-scroll .arrow {
            width: 24px; height: 24px; border: 1px solid var(--line-strong); border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            animation: bob 2s ease-in-out infinite;
        }

        /* ===== КНОПКИ ===== */
        .btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 10px;
            padding: 16px 28px; font-size: 14px; font-weight: 500;
            font-family: inherit; text-decoration: none; border-radius: 100px;
            border: 1px solid var(--ink); background: var(--ink); color: var(--bg);
            cursor: none; position: relative; overflow: hidden;
            transition: color 0.4s cubic-bezier(0.16,1,0.3,1), border-color 0.4s;
            min-height: 48px;
        }
        .btn::before {
            content: ''; position: absolute; inset: 0; background: var(--accent);
            transform: translateY(101%); transition: transform 0.5s cubic-bezier(0.16,1,0.3,1); z-index: 0;
        }
        .btn:hover::before { transform: translateY(0); }
        .btn span, .btn .arrow-icon { position: relative; z-index: 1; }
        .btn:hover { color: #fff; }
        .btn .arrow-icon { transition: transform 0.4s cubic-bezier(0.16,1,0.3,1); }
        .btn:hover .arrow-icon { transform: translateX(4px); }
        .btn-outline {
            background: transparent; color: var(--ink); border-color: var(--line-strong);
        }
        .btn-outline::before { background: var(--ink); }
        .btn-outline:hover { color: var(--bg); border-color: var(--ink); }
        .btn-sm { padding: 12px 20px; font-size: 13px; min-height: 44px; }

        /* ===== СЕКЦИИ ===== */
        section {
            padding: 140px calc(var(--safe-right) + 56px) 140px calc(var(--safe-left) + 56px);
            position: relative;
        }
        .section-head {
            display: flex; align-items: baseline; justify-content: space-between;
            margin-bottom: 80px; border-bottom: 1px solid var(--line); padding-bottom: 24px;
            gap: 24px;
        }
        .section-label {
            font-size: 12px; color: var(--ink-mute); letter-spacing: 0.15em; text-transform: uppercase;
            flex-shrink: 0;
        }
        .section-title {
            font-size: clamp(28px, 4vw, 48px); font-weight: 600;
            letter-spacing: -0.03em; text-align: right;
        }
        .section-title em { font-style: normal; color: var(--accent); }

        .reveal {
            opacity: 0; transform: translateY(40px);
            transition: opacity 0.9s cubic-bezier(0.16,1,0.3,1), transform 0.9s cubic-bezier(0.16,1,0.3,1);
        }
        .reveal.visible { opacity: 1; transform: translateY(0); }

        /* ===== ABOUT ===== */
        .about-grid {
            display: grid; grid-template-columns: 1fr 1fr;
            gap: 100px; align-items: start;
        }
        .about-image {
            position: relative; aspect-ratio: 4/5; overflow: hidden;
            border-radius: 4px; background: var(--bg-alt);
        }
        .about-image img {
            width: 100%; height: 100%; object-fit: cover;
            transition: transform 0.9s cubic-bezier(0.16,1,0.3,1);
            filter: grayscale(100%) brightness(0.85);
        }
        .about-text h3 {
            font-size: clamp(22px, 3vw, 26px); font-weight: 600; letter-spacing: -0.02em;
            margin-bottom: 24px; line-height: 1.3;
        }
        .about-text p {
            color: var(--ink-soft); line-height: 1.8; margin-bottom: 20px; font-size: 15px;
        }
        .about-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0; }
        .tag {
            font-size: 12px; color: var(--ink-soft); padding: 8px 14px;
            border: 1px solid var(--line-strong); border-radius: 100px; transition: all 0.3s;
        }
        .about-stats {
            display: grid; grid-template-columns: 1fr 1fr; gap: 1px;
            background: var(--line); border: 1px solid var(--line); margin-top: 40px;
        }
        .stat { background: var(--bg); padding: 24px; }
        .stat-num {
            font-size: clamp(28px, 4vw, 36px); font-weight: 600; letter-spacing: -0.03em;
            line-height: 1; margin-bottom: 8px; font-variant-numeric: tabular-nums;
        }
        .stat-num em { font-style: normal; color: var(--accent); }
        .stat-label { font-size: 13px; color: var(--ink-mute); }

        /* ===== SKILLS ===== */
        .skills-list { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
        .skill-row {
            display: grid; grid-template-columns: 60px 1fr 2fr auto;
            gap: 30px; align-items: center; padding: 28px 24px; margin: 0 -24px;
            border-bottom: 1px solid var(--line); position: relative; cursor: none;
            transition: padding 0.5s cubic-bezier(0.16,1,0.3,1);
        }
        .skill-row::before {
            content: ''; position: absolute; inset: 0; background: var(--bg-elev);
            transform: scaleY(0); transform-origin: bottom;
            transition: transform 0.5s cubic-bezier(0.16,1,0.3,1); z-index: 0; border-radius: 6px;
        }
        .skill-row > * { position: relative; z-index: 1; transition: color 0.4s; }
        .skill-num {
            font-size: 13px; color: var(--ink-mute); font-variant-numeric: tabular-nums;
            transition: color 0.4s;
        }
        .skill-name { font-size: clamp(18px, 2.5vw, 22px); font-weight: 600; letter-spacing: -0.02em; }
        .skill-desc { font-size: 14px; color: var(--ink-soft); transition: color 0.4s; }
        .skill-tag {
            font-size: 12px; color: var(--ink-mute); letter-spacing: 0.05em;
            text-transform: uppercase; padding: 6px 14px;
            border: 1px solid var(--line-strong); border-radius: 100px; transition: all 0.4s;
        }

        /* ===== ПРОЦЕСС ===== */
        .process-list {
            display: flex; flex-direction: column; position: relative; padding-left: 40px;
        }
        .process-list::before {
            content: ''; position: absolute; left: 7px; top: 20px; bottom: 20px;
            width: 1px; background: var(--line-strong);
        }
        .process-step {
            position: relative; padding: 24px 0;
            display: grid; grid-template-columns: 60px 1fr 2fr; gap: 30px; align-items: baseline;
        }
        .process-step::before {
            content: ''; position: absolute; left: -40px; top: 34px;
            width: 15px; height: 15px; border: 2px solid var(--accent);
            background: var(--bg); border-radius: 50%; z-index: 1; transition: all 0.4s;
        }
        .process-num {
            font-size: 13px; color: var(--ink-mute); font-variant-numeric: tabular-nums; letter-spacing: 0.1em;
        }
        .process-name { font-size: clamp(18px, 2.5vw, 20px); font-weight: 600; letter-spacing: -0.02em; }
        .process-desc { font-size: 14px; color: var(--ink-soft); line-height: 1.7; }

        /* ===== ЦЕНЫ ===== */
        .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
        .price-card {
            border: 1px solid var(--line-strong); border-radius: 12px;
            padding: 40px 32px; position: relative;
            transition: all 0.5s cubic-bezier(0.16,1,0.3,1); cursor: none;
            background: var(--bg); display: flex; flex-direction: column;
        }
        .price-card.featured {
            border-color: var(--accent);
            background: linear-gradient(180deg, rgba(255,92,53,0.05), var(--bg));
        }
        .price-badge {
            position: absolute; top: -12px; left: 32px;
            background: var(--accent); color: #fff;
            font-size: 11px; font-weight: 600; letter-spacing: 0.1em;
            text-transform: uppercase; padding: 5px 12px; border-radius: 100px;
        }
        .price-title {
            font-size: 14px; font-weight: 500; letter-spacing: 0.1em;
            text-transform: uppercase; color: var(--ink-mute); margin-bottom: 20px;
        }
        .price-amount {
            font-size: clamp(32px, 4vw, 40px); font-weight: 600; letter-spacing: -0.03em;
            line-height: 1; margin-bottom: 8px;
        }
        .price-amount span {
            font-size: 14px; color: var(--ink-mute); font-weight: 400;
            margin-left: 8px; letter-spacing: 0;
        }
        .price-desc {
            font-size: 14px; color: var(--ink-soft); line-height: 1.7;
            margin-bottom: 28px; padding-bottom: 28px; border-bottom: 1px solid var(--line);
        }
        .price-features {
            list-style: none; display: flex; flex-direction: column;
            gap: 14px; margin-bottom: 32px; flex: 1;
        }
        .price-features li {
            font-size: 14px; color: var(--ink-soft); display: flex;
            align-items: flex-start; gap: 10px; line-height: 1.5;
        }
        .price-features li::before {
            content: '✓'; color: var(--accent); font-weight: 600; flex-shrink: 0;
        }
        .price-card .btn { width: 100%; justify-content: center; }

        /* ===== ПОРТФОЛИО ===== */
        .portfolio-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
        .work {
            position: relative; aspect-ratio: 4/3; overflow: hidden; border-radius: 6px;
            cursor: none; background: var(--bg-alt); display: block; text-decoration: none;
            transition: transform 0.5s cubic-bezier(0.16,1,0.3,1);
            transform-style: preserve-3d;
            -webkit-tap-highlight-color: transparent;
        }
        .work img {
            width: 100%; height: 100%; object-fit: cover;
            transition: transform 0.9s cubic-bezier(0.16,1,0.3,1);
            filter: grayscale(100%) brightness(0.7);
        }
        .work-info {
            position: absolute; bottom: 24px; left: 24px; right: 24px;
            display: flex; justify-content: space-between; align-items: flex-end;
            color: #fff; z-index: 2;
        }
        .work-info::before {
            content: ''; position: absolute; bottom: -24px; left: -24px; right: -24px; height: 140px;
            background: linear-gradient(to top, rgba(26,26,29,0.9), transparent);
            z-index: -1; opacity: 0; transition: opacity 0.5s;
        }
        .work-info h4 {
            font-size: 18px; font-weight: 600; letter-spacing: -0.01em;
            transform: translateY(12px); opacity: 0;
            transition: all 0.5s cubic-bezier(0.16,1,0.3,1);
        }
        .work-info > div > span {
            font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
            opacity: 0; transform: translateY(12px);
            transition: all 0.5s cubic-bezier(0.16,1,0.3,1) 0.05s;
        }
        .work-arrow {
            width: 44px; height: 44px; border: 1px solid rgba(255,255,255,0.4);
            border-radius: 50%; display: flex; align-items: center; justify-content: center;
            font-size: 18px; transform: scale(0); transition: all 0.5s cubic-bezier(0.16,1,0.3,1);
            flex-shrink: 0;
        }
        .work-placeholder {
            position: absolute; inset: 0; display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: 12px;
            background: var(--bg-alt); color: var(--ink-mute); transition: all 0.5s;
        }
        .work-placeholder .icon { font-size: 32px; opacity: 0.5; }
        .work-placeholder .label {
            font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase;
        }

        /* ===== FAQ ===== */
        .faq-list {
            display: flex; flex-direction: column; border-top: 1px solid var(--line);
            max-width: 900px; margin: 0 auto;
        }
        .faq-item { border-bottom: 1px solid var(--line); cursor: none; }
        .faq-question {
            padding: 24px 0; display: flex; justify-content: space-between; align-items: center;
            gap: 20px; font-size: clamp(16px, 2.5vw, 18px); font-weight: 500; letter-spacing: -0.01em;
            transition: color 0.3s;
            min-height: 64px;
        }
        .faq-icon {
            width: 32px; height: 32px; border: 1px solid var(--line-strong); border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; flex-shrink: 0;
            transition: all 0.4s cubic-bezier(0.16,1,0.3,1); position: relative;
        }
        .faq-icon::before, .faq-icon::after {
            content: ''; position: absolute; background: currentColor;
            transition: transform 0.4s cubic-bezier(0.16,1,0.3,1);
        }
        .faq-icon::before { width: 12px; height: 1.5px; }
        .faq-icon::after { width: 1.5px; height: 12px; }
        .faq-item.open .faq-icon { background: var(--accent); border-color: var(--accent); color: #fff; }
        .faq-item.open .faq-icon::after { transform: rotate(90deg); opacity: 0; }
        .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.6s cubic-bezier(0.16,1,0.3,1); }
        .faq-answer-inner {
            padding: 0 0 24px; color: var(--ink-soft); line-height: 1.8;
            font-size: 15px; max-width: 720px;
        }
        .faq-item.open .faq-answer { max-height: 500px; }

        /* ===== КОНТАКТЫ ===== */
        .contact-wrap {
            display: grid; grid-template-columns: 1fr 1.2fr;
            gap: 100px; align-items: start;
        }
        .contact-left h3 {
            font-size: clamp(28px, 4vw, 52px); font-weight: 600;
            letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 24px;
        }
        .contact-left h3 em { font-style: normal; color: var(--accent); }
        .contact-left p { color: var(--ink-soft); line-height: 1.8; margin-bottom: 32px; }
        .contact-channels { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
        .channel {
            display: flex; align-items: center; justify-content: space-between;
            padding: 20px 0; border-bottom: 1px solid var(--line);
            text-decoration: none; color: var(--ink); cursor: none;
            transition: padding 0.4s cubic-bezier(0.16,1,0.3,1);
            min-height: 60px; gap: 16px;
        }
        .channel-label {
            font-size: 13px; color: var(--ink-mute); letter-spacing: 0.1em;
            text-transform: uppercase; margin-bottom: 4px;
        }
        .channel-value {
            font-size: clamp(14px, 2.5vw, 18px); font-weight: 500; transition: color 0.3s;
            word-break: break-all;
        }
        .channel-arrow {
            font-size: 20px; color: var(--ink-mute);
            transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
            flex-shrink: 0;
        }

        .contact-form { display: flex; flex-direction: column; gap: 8px; }
        .field {
            position: relative; border-bottom: 1px solid var(--line-strong); transition: border-color 0.4s;
        }
        .field:focus-within { border-color: var(--ink); }
        .field input, .field textarea {
            width: 100%; padding: 22px 0; background: transparent; border: none;
            color: var(--ink); font-size: 16px; font-family: inherit;
            outline: none; cursor: none; resize: none;
            -webkit-appearance: none; border-radius: 0;
        }
        .field textarea { min-height: 100px; }
        .field input::placeholder, .field textarea::placeholder { color: var(--ink-mute); }
        .field label {
            position: absolute; top: 22px; left: 0; font-size: 12px; color: var(--accent);
            letter-spacing: 0.1em; text-transform: uppercase; opacity: 0;
            transform: translateY(-6px); transition: all 0.3s; pointer-events: none;
        }
        .field:focus-within label { opacity: 1; transform: translateY(-14px); }
        .field:focus-within input::placeholder,
        .field:focus-within textarea::placeholder { opacity: 0; }
        .contact-form .btn { align-self: flex-start; margin-top: 32px; }
        .form-status { font-size: 13px; margin-top: 16px; min-height: 20px; }
        .form-status.error { color: #ff5555; }
        .form-status.success { color: #4ade80; }

        /* ===== ПЛАВАЮЩАЯ КНОПКА ===== */
        .floating-tg {
            position: fixed;
            bottom: calc(var(--safe-bottom) + 24px);
            right: calc(var(--safe-right) + 24px);
            width: 60px; height: 60px;
            background: var(--accent); border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: #fff; text-decoration: none; z-index: 999;
            box-shadow: 0 10px 30px rgba(255,92,53,0.4); cursor: none;
            transition: transform 0.4s cubic-bezier(0.16,1,0.3,1), opacity 0.4s;
            opacity: 0; transform: translateY(20px) scale(0.8); pointer-events: none;
            -webkit-tap-highlight-color: transparent;
        }
        .floating-tg.visible { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
        .floating-tg.hidden-scroll { transform: translateY(100px) scale(0.8); opacity: 0; }
        .floating-tg::before {
            content: ''; position: absolute; inset: 0; border-radius: 50%;
            background: var(--accent); animation: pulse-ring 2s infinite; z-index: -1;
        }
        .floating-tg svg { width: 28px; height: 28px; }
        .floating-tg:active { transform: translateY(0) scale(0.94); }

        /* ===== ФУТЕР ===== */
        footer {
            padding: 48px calc(var(--safe-right) + 56px) calc(var(--safe-bottom) + 48px) calc(var(--safe-left) + 56px);
            border-top: 1px solid var(--line);
            display: flex; justify-content: space-between; align-items: center;
            flex-wrap: wrap; gap: 24px;
        }
        .footer-copy { font-size: 13px; color: var(--ink-mute); }
        .socials { display: flex; gap: 8px; flex-wrap: wrap; }
        .social-link {
            font-size: 13px; color: var(--ink-soft); text-decoration: none;
            padding: 12px 18px; border: 1px solid var(--line-strong); border-radius: 100px;
            cursor: none; transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
            min-height: 44px; display: inline-flex; align-items: center;
        }

        /* ===== АНИМАЦИИ ===== */
        @keyframes rise { to { opacity: 1; transform: translateY(0); } }
        @keyframes revealLine { to { transform: translateY(0); } }
        @keyframes bob {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(4px); }
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(0.8); }
        }
        @keyframes pulse-ring {
            0% { transform: scale(1); opacity: 0.6; }
            100% { transform: scale(1.6); opacity: 0; }
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

        /* ===== СМЕНА ЯЗЫКА ===== */
        [data-lang] { display: none !important; }
        html[lang="ru"] [data-lang="ru"] { display: inline !important; }
        html[lang="en"] [data-lang="en"] { display: inline !important; }
        html[lang="ru"] .hero-title .line span[data-lang="ru"],
        html[lang="en"] .hero-title .line span[data-lang="en"] { display: inline-block !important; }
        html[lang="ru"] .block[data-lang="ru"],
        html[lang="en"] .block[data-lang="en"],
        html[lang="ru"] .work-info h4[data-lang="ru"],
        html[lang="en"] .work-info h4[data-lang="en"],
        html[lang="ru"] .work-info > div > span[data-lang="ru"],
        html[lang="en"] .work-info > div > span[data-lang="en"],
        html[lang="ru"] .work-placeholder .label[data-lang="ru"],
        html[lang="en"] .work-placeholder .label[data-lang="en"],
        html[lang="ru"] .field label[data-lang="ru"],
        html[lang="en"] .field label[data-lang="en"],
        html[lang="ru"] .stat-label[data-lang="ru"],
        html[lang="en"] .stat-label[data-lang="en"],
        html[lang="ru"] .price-title[data-lang="ru"],
        html[lang="en"] .price-title[data-lang="en"] { display: block !important; }
        html[lang="ru"] .flex[data-lang="ru"],
        html[lang="en"] .flex[data-lang="en"] { display: flex !important; }

        /* ===== HOVER-ЭФФЕКТЫ ТОЛЬКО ДЛЯ МЫШИ ===== */
        @media (hover: hover) and (pointer: fine) {
            .about-image:hover img { transform: scale(1.05); filter: grayscale(0%) brightness(1); }
            .skill-row:hover::before { transform: scaleY(1); }
            .skill-row:hover .skill-num { color: var(--accent); }
            .skill-row:hover .skill-tag { border-color: var(--accent); color: var(--accent); }
            .process-step:hover::before { background: var(--accent); transform: scale(1.2); }
            .price-card:hover {
                border-color: var(--accent); transform: translateY(-6px);
                box-shadow: 0 20px 60px rgba(255,92,53,0.12);
            }
            .work:hover img { transform: scale(1.06); filter: grayscale(0%) brightness(1); }
            .work:hover .work-info::before { opacity: 1; }
            .work:hover .work-info h4,
            .work:hover .work-info > div > span { transform: translateY(0); opacity: 1; }
            .work:hover .work-arrow { transform: scale(1); background: var(--accent); border-color: var(--accent); }
            .work:hover .work-placeholder { background: var(--bg-elev); color: var(--ink-soft); }
            .faq-item:hover .faq-question { color: var(--accent); }
            .channel:hover { padding-left: 8px; }
            .channel:hover .channel-value { color: var(--accent); }
            .channel:hover .channel-arrow { color: var(--accent); transform: translate(3px, -3px); }
            .social-link:hover {
                background: var(--ink); color: var(--bg); border-color: var(--ink); transform: translateY(-2px);
            }
            .floating-tg:hover { transform: translateY(-4px) scale(1.08); }
            .tag:hover { border-color: var(--accent); color: var(--accent); }
        }

        /* На тач — всегда показываем hover-info у работ */
        @media (hover: none) {
            .work-info::before { opacity: 1; }
            .work-info h4, .work-info > div > span { opacity: 1; transform: none; }
            .work-arrow { transform: scale(1); }
        }

        /* ===== АДМИНКА ===== */
        .admin-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,0.7);
            backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); z-index: 10001;
            opacity: 0; pointer-events: none; transition: opacity 0.4s;
        }
        .admin-overlay.open { opacity: 1; pointer-events: auto; }

        .admin-panel {
            position: fixed; top: 0; right: 0; height: 100dvh; width: 480px;
            max-width: 92vw; background: var(--bg-alt);
            border-left: 1px solid var(--line-strong); z-index: 10002;
            transform: translateX(100%); transition: transform 0.5s cubic-bezier(0.16,1,0.3,1);
            display: flex; flex-direction: column; cursor: auto;
        }
        .admin-panel.open { transform: translateX(0); }
        .admin-panel * { cursor: auto; }

        .admin-header {
            padding: 24px 28px; border-bottom: 1px solid var(--line);
            display: flex; justify-content: space-between; align-items: center;
            flex-shrink: 0;
        }
        .admin-title {
            display: flex; align-items: center; gap: 10px;
            font-size: 15px; font-weight: 600; letter-spacing: -0.01em;
        }
        .admin-title .badge {
            font-size: 10px; padding: 3px 8px; background: var(--accent);
            color: #fff; border-radius: 100px; font-weight: 600; letter-spacing: 0.05em;
        }
        .admin-close {
            width: 36px; height: 36px; border: 1px solid var(--line-strong);
            background: transparent; color: var(--ink); border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px; cursor: pointer; transition: all 0.3s;
            min-height: 36px;
        }

        .admin-tabs {
            display: flex; gap: 2px; padding: 12px 28px 0;
            border-bottom: 1px solid var(--line); overflow-x: auto; flex-shrink: 0;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }
        .admin-tabs::-webkit-scrollbar { display: none; }
        .admin-tab {
            padding: 12px 16px; background: transparent; border: none;
            color: var(--ink-mute); font-family: inherit; font-size: 13px; font-weight: 500;
            cursor: pointer; border-radius: 8px 8px 0 0; position: relative;
            transition: all 0.3s; white-space: nowrap; min-height: 44px;
        }
        .admin-tab.active {
            color: var(--ink); background: var(--bg-elev);
        }
        .admin-tab.active::after {
            content: ''; position: absolute; bottom: -1px; left: 0; right: 0;
            height: 2px; background: var(--accent);
        }

        .admin-body {
            flex: 1; overflow-y: auto; padding: 24px 28px;
            -webkit-overflow-scrolling: touch;
        }
        .admin-body::-webkit-scrollbar { width: 6px; }
        .admin-body::-webkit-scrollbar-track { background: transparent; }
        .admin-body::-webkit-scrollbar-thumb {
            background: var(--line-strong); border-radius: 3px;
        }

        .admin-section { display: none; }
        .admin-section.active { display: block; animation: fadeIn 0.3s ease; }

        .admin-group { margin-bottom: 32px; }
        .admin-group-title {
            font-size: 11px; color: var(--ink-mute); letter-spacing: 0.1em;
            text-transform: uppercase; margin-bottom: 14px; font-weight: 600;
        }

        .admin-field { margin-bottom: 16px; }
        .admin-field label {
            display: block; font-size: 12px; color: var(--ink-soft);
            margin-bottom: 6px; font-weight: 500;
        }
        .admin-field input[type="text"],
        .admin-field input[type="email"],
        .admin-field input[type="number"],
        .admin-field input[type="password"],
        .admin-field textarea,
        .admin-field select {
            width: 100%; padding: 12px 14px; background: var(--bg);
            border: 1px solid var(--line-strong); border-radius: 8px;
            color: var(--ink); font-family: inherit; font-size: 16px; outline: none;
            transition: border-color 0.3s; min-height: 44px;
            -webkit-appearance: none;
        }
        .admin-field input:focus,
        .admin-field textarea:focus,
        .admin-field select:focus { border-color: var(--accent); }
        .admin-field textarea { resize: vertical; min-height: 70px; }

        .admin-toggle-row {
            display: flex; justify-content: space-between; align-items: center;
            padding: 14px 0; border-bottom: 1px solid var(--line); gap: 16px;
        }
        .admin-toggle-row:last-child { border-bottom: none; }
        .admin-toggle-label { font-size: 13px; color: var(--ink); }
        .admin-toggle-desc {
            font-size: 11px; color: var(--ink-mute); margin-top: 2px;
        }

        .switch {
            position: relative; width: 44px; height: 26px;
            background: var(--line-strong); border-radius: 100px;
            cursor: pointer; transition: background 0.3s; flex-shrink: 0;
        }
        .switch::after {
            content: ''; position: absolute; top: 3px; left: 3px;
            width: 20px; height: 20px; background: var(--ink); border-radius: 50%;
            transition: transform 0.3s cubic-bezier(0.16,1,0.3,1);
        }
        .switch.on { background: var(--accent); }
        .switch.on::after { transform: translateX(18px); background: #fff; }

        .color-swatches { display: flex; gap: 10px; flex-wrap: wrap; }
        .color-swatch {
            width: 48px; height: 48px; border-radius: 50%;
            cursor: pointer; border: 2px solid transparent;
            transition: all 0.3s; position: relative;
        }
        .color-swatch.active {
            border-color: var(--ink);
            box-shadow: 0 0 0 3px var(--bg-alt);
        }
        .color-swatch.active::after {
            content: '✓'; position: absolute; inset: 0;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 18px; font-weight: 700;
        }

        .admin-btn {
            padding: 12px 18px; background: var(--accent); color: #fff;
            border: none; border-radius: 8px; font-family: inherit;
            font-size: 13px; font-weight: 500; cursor: pointer;
            transition: all 0.3s; display: inline-flex; align-items: center; justify-content: center; gap: 6px;
            min-height: 44px;
        }
        .admin-btn.secondary {
            background: transparent; color: var(--ink); border: 1px solid var(--line-strong);
        }
        .admin-btn.danger {
            background: transparent; color: #ff5555; border: 1px solid rgba(255,85,85,0.3);
        }
        .admin-btn-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }

        .stats-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
        }
        .stat-card {
            background: var(--bg); border: 1px solid var(--line); border-radius: 10px;
            padding: 16px;
        }
        .stat-card-num {
            font-size: 28px; font-weight: 600; letter-spacing: -0.02em;
            line-height: 1; margin-bottom: 4px; color: var(--accent);
        }
        .stat-card-label {
            font-size: 11px; color: var(--ink-mute); letter-spacing: 0.05em; text-transform: uppercase;
        }

        .admin-log {
            background: var(--bg); border: 1px solid var(--line); border-radius: 8px;
            padding: 12px; max-height: 200px; overflow-y: auto;
            font-family: 'Courier New', monospace; font-size: 11px;
            line-height: 1.6; color: var(--ink-soft);
        }
        .admin-log-entry { margin-bottom: 4px; }
        .admin-log-entry .time { color: var(--ink-mute); margin-right: 8px; }
        .admin-log-entry .type-info { color: #4ade80; }
        .admin-log-entry .type-warn { color: #fbbf24; }
        .admin-log-entry .type-error { color: #ff5555; }

        .admin-work-item {
            background: var(--bg); border: 1px solid var(--line);
            border-radius: 8px; padding: 12px; margin-bottom: 8px;
            display: flex; justify-content: space-between; align-items: center; gap: 12px;
        }
        .admin-work-item-info { flex: 1; min-width: 0; }
        .admin-work-item-title {
            font-size: 13px; font-weight: 500; margin-bottom: 2px;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .admin-work-item-meta { font-size: 11px; color: var(--ink-mute); }
        .admin-work-remove {
            width: 32px; height: 32px; border: 1px solid var(--line-strong);
            background: transparent; color: var(--ink-mute); border-radius: 50%;
            cursor: pointer; transition: all 0.3s; flex-shrink: 0;
            min-height: 32px;
        }

        .admin-empty {
            padding: 24px; text-align: center; color: var(--ink-mute);
            font-size: 13px; border: 1px dashed var(--line-strong); border-radius: 8px;
        }

        .admin-hint {
            padding: 10px 14px; background: rgba(255,92,53,0.08);
            border-left: 2px solid var(--accent); border-radius: 4px;
            font-size: 12px; color: var(--ink-soft); margin-bottom: 16px;
        }

        body.editing [data-editable] {
            outline: 1.5px dashed var(--accent);
            outline-offset: 4px; cursor: text;
            transition: outline-color 0.3s;
        }
        body.editing .floating-tg,
        body.editing .cursor-dot,
        body.editing .cursor-ring { display: none; }
        body.editing * { cursor: text; }
        body.editing a, body.editing button { cursor: pointer; }

        .edit-indicator {
            position: fixed; top: calc(var(--safe-top) + 16px); left: 50%; transform: translateX(-50%);
            background: var(--accent); color: #fff; padding: 10px 18px;
            border-radius: 100px; font-size: 12px; font-weight: 600;
            z-index: 9996; display: none; align-items: center; gap: 8px;
            box-shadow: 0 8px 24px rgba(255,92,53,0.4);
            max-width: calc(100vw - 32px); text-align: center;
        }
        .edit-indicator.visible { display: flex; }
        .edit-indicator .dot {
            width: 8px; height: 8px; background: #fff; border-radius: 50%;
            animation: pulse 1.5s infinite; flex-shrink: 0;
        }

        /* ===== PIN-ЭКРАН ===== */
        .pin-screen {
            position: fixed; inset: 0; z-index: 10003;
            background: var(--bg); display: none;
            align-items: center; justify-content: center;
            cursor: auto; padding: 20px;
            padding-top: calc(var(--safe-top) + 20px);
            padding-bottom: calc(var(--safe-bottom) + 20px);
            overflow-y: auto;
        }
        .pin-screen.open { display: flex; }
        .pin-screen * { cursor: auto; }

        .pin-box {
            width: 100%; max-width: 380px; text-align: center;
